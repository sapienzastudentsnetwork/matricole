---
import CourseCard from './CourseCard.astro';

interface Props {
  bachelorLabel: string;
  bachelorTitle: string;
  bachelorCount: number;
  bachelorCourses: Array<{
    id: string;
    color: string;
    name: string;
    full: Record<string, string>;
    crest: string;
    whatsapp?: string;
    telegram?: string;
    wiki: string;
  }>;
  masterLabel: string;
  masterTitle: string;
  masterCount: number;
  masterCourses: Array<{
    id: string;
    color: string;
    name: string;
    full: Record<string, string>;
    crest: string;
    whatsapp?: string;
    telegram?: string;
    wiki: string;
  }>;
  language: string;
}

const {
  bachelorLabel,
  bachelorTitle,
  bachelorCount,
  bachelorCourses,
  masterLabel,
  masterTitle,
  masterCount,
  masterCourses,
  language,
} = Astro.props;
---

<section id="courses" class="courses max-w-[1120px] mx-auto px-7 sm:px-6 md:px-5 py-20 max-md:pt-16 max-md:pb-14 border-b border-base-300">
  <!-- Bachelor's section -->
  <div class="section-head flex justify-between items-end mb-6">
    <div>
      <span class="text-[14px] font-bold uppercase tracking-[0.16em] text-secondary">{bachelorLabel}</span>
      <h2 
        id="bachelors-title"
        class="font-heading text-[clamp(32px,5vw,46px)] font-bold mt-1.5 tracking-[-0.035em]"
      >
        {bachelorTitle}
      </h2>
    </div>
    <span class="count grid place-items-center w-9 h-9 border border-base-300 rounded-full text-secondary text-[16px] font-bold">
      {bachelorCount}
    </span>
  </div>
  <div class="course-grid grid grid-cols-1 md:grid-cols-2 gap-[18px]">
    {bachelorCourses.map((course) => (
      <CourseCard course={course} language={language} />
    ))}
  </div>

  <!-- Master's section -->
  <div class="section-head masters flex justify-between items-end mt-20 max-md:mt-16 mb-6">
    <div>
      <span class="text-[14px] font-bold uppercase tracking-[0.16em] text-secondary">{masterLabel}</span>
      <h2 
        id="masters-title"
        class="font-heading text-[clamp(32px,5vw,46px)] font-bold mt-1.5 tracking-[-0.035em]"
      >
        {masterTitle}
      </h2>
    </div>
    <span class="count grid place-items-center w-9 h-9 border border-base-300 rounded-full text-secondary text-[16px] font-bold">
      {masterCount}
    </span>
  </div>
  <div class="course-grid master-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[18px]">
    {masterCourses.map((course) => (
      <CourseCard course={course} language={language} />
    ))}
  </div>
</section>
