---
interface Props {
    academicYear: string;
    title: string;
    lead: string;
    chooseText: string;
}

const { academicYear, title, lead, chooseText } = Astro.props;
---

<section
    class="hero-section max-w-[920px] mx-auto text-center px-8 sm:px-12 pt-[86px] pb-[100px] max-md:pt-[62px] max-md:pb-[70px] flex flex-col items-center"
>
    <div
        class="eyebrow inline-flex gap-2.5 items-center text-text-dim text-[13px] font-bold uppercase tracking-[0.18em] mb-6"
    >
        <span
            class="w-[7px] h-[7px] bg-primary rounded-full shadow-[0_0_18px_var(--color-primary)]"
        ></span>
        <span>{academicYear}</span>
    </div>
    <h1
        class="font-heading font-bold text-[clamp(45px,9vw,92px)] max-md:text-[clamp(44px,15vw,68px)] leading-[1.04] tracking-[-0.055em] my-6"
        set:html={title}
    />
    <p
        class="lead text-[clamp(19px,2.4vw,23px)] leading-[1.6] text-text-dim font-medium max-w-[660px] mx-auto mb-8 px-4 sm:px-6"
        set:html={lead}
    />
    <div class="aura aura-xl text-primary bg-text-dim/40">
        <a
            class="jump inline-flex items-center gap-3 no-underline bg-surface-btn-light text-text-dark-cta text-[18px] font-bold px-[19px] py-[14px] rounded-xl hover:bg-white transition-colors"
            href="#how"
        >
            <span>{chooseText}</span>
            <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="w-[18px] h-[18px] fill-none stroke-current stroke-2"
            >
                <path d="m6 9 6 6 6-6"></path>
            </svg>
        </a>
    </div>
</section>
