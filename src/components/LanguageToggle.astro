---
interface Props {
  language: string;
}

const { language } = Astro.props;
const isIt = language === 'it';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const itHref = `${base}/` || '/';
const enHref = `${base}/en`;
---

<div class="inline-flex bg-base-200/80 border border-base-300 p-0.5 rounded-full" role="group" aria-label="Language">
  <a 
    href={itHref}
    class:list={[
      "px-2.5 py-1 text-[14px] font-bold rounded-full transition-all duration-150 no-underline",
      isIt ? "bg-white text-gray-900 shadow-sm" : "text-secondary hover:text-base-content",
    ]}
    aria-pressed={isIt}
  >
    IT
  </a>
  <a 
    href={enHref}
    class:list={[
      "px-2.5 py-1 text-[14px] font-bold rounded-full transition-all duration-150 no-underline",
      !isIt ? "bg-white text-gray-900 shadow-sm" : "text-secondary hover:text-base-content",
    ]}
    aria-pressed={!isIt}
  >
    EN
  </a>
</div>


